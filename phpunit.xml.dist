<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true">
	<testsuites>
		<!--
			qualify-v2-unit: pure-PHP unit tests that do NOT require the WP
			test framework. These cover the QualifyVerdict canonicalizer, the
			verdict-resolution decision tree, and the platform detector.

			EventSubmissionAbilitiesTest extends WP_UnitTestCase and needs a
			live Data Machine install for datamachine/execute-workflow, neither
			of which tests/bootstrap.php's plain-PHP doubles provide. It is
			intentionally left out of this dist config; it runs instead in
			phpunit-managed.xml.dist's managed-wordpress suite, which has the
			real WP test framework plus Data Machine active.
		-->
		<testsuite name="qualify-v2-unit">
			<directory>tests/Unit/Core</directory>
			<file>tests/Unit/Abilities/VenueQualificationTicketmasterPrecheckTest.php</file>
			<file>tests/Unit/Abilities/CanonicalLocationsAbilityTest.php</file>
			<file>tests/Unit/Abilities/PublicEntityProjectionsAbilityTest.php</file>
			<file>tests/Unit/Abilities/EventsByTermTaxonomyContextTest.php</file>
			<file>tests/Unit/Abilities/EventsByArtistAbilityTest.php</file>
			<file>tests/Unit/Abilities/CanonicalAdapterContractsTest.php</file>
			<file>tests/Unit/Abilities/ArtistUrlImportNotificationTest.php</file>
			<file>tests/Unit/Abilities/ArtistUrlImportConfigurationContractTest.php</file>
			<file>tests/Unit/Abilities/EventSourceIntakeTest.php</file>
			<file>tests/Unit/Abilities/EventSubmissionExecuteDirectAuthContextTest.php</file>
		<file>tests/Unit/Abilities/EventSubmissionWorkflowStepShapeTest.php</file>
			<file>tests/Unit/Abilities/PriorityBoostAbilityTest.php</file>
			<file>tests/Unit/Abilities/EventsUpcomingCountsTest.php</file>
			<file>tests/Unit/Core/VenueExpansionPlanTest.php</file>
			<file>tests/Unit/Core/VenueExpansionRunnerTest.php</file>
			<file>tests/Unit/Core/VenueExpansionSystemTaskTest.php</file>
			<file>tests/Unit/Core/GenreSyncTest.php</file>
			<file>tests/Unit/Cli/BackfillEventTypeClassifyTest.php</file>
			<file>tests/Unit/Cli/ClassifyVenueTierScoreTest.php</file>
			<file>tests/Unit/Cli/ClassifyGenreDeterministicTest.php</file>
			<file>tests/Unit/SingleEventNetworkBridgeTest.php</file>
			<file>tests/Unit/ConcertStatsPublicProfileRenderTest.php</file>
			<file>tests/Unit/VenueBookingInquiryRenderTest.php</file>
			<file>tests/AbilityRegistrationLifecycleTest.php</file>
			<file>tests/VenueLinkPagesCoordinatedRuntimeTest.php</file>
			<file>tests/VenueLinkPagesRuntimeVersionContractTest.php</file>
			<file>tests/VenueSettingsRenderLinkPagesDegradationTest.php</file>
			<file>tests/PromoterLinkPagesCoordinatedRuntimeTest.php</file>
		</testsuite>
		<testsuite name="venue-membership-authorization">
			<file>tests/VenueMembershipAuthorizationTest.php</file>
			<file>tests/ArtistBookingInquiryTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
